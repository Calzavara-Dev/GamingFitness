{
  "expo": {
    "name": "Gaming Fitness",
    "slug": "gaming-fitness",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon_new.png",
    "scheme": "gamingfitness",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050B14",
        "foregroundImage": "./assets/images/icon_new.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.calzavara.gamingfitness"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050B14",
          "image": "./assets/images/icon_new.png",
          "imageWidth": 200
        }
      ],
      "expo-notifications",
      "expo-audio",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8848ea06-d271-4d83-af3e-fa276ed7d248"
      }
    }
  }
}
